{
  "name": "aseprite-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent draw pixel art live in Aseprite by writing JavaScript programs",
  "keywords": [
    "ai-agent",
    "aseprite",
    "code-mode",
    "mcp",
    "model-context-protocol",
    "pixel-art"
  ],
  "homepage": "https://github.com/ParthMmm/aseprite-mcp#readme",
  "bugs": {
    "url": "https://github.com/ParthMmm/aseprite-mcp/issues"
  },
  "license": "Unlicense",
  "author": "Parth Mangrola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParthMmm/aseprite-mcp.git"
  },
  "bin": {
    "aseprite-mcp": "bin/aseprite-mcp.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "bin/aseprite-mcp.ts",
  "scripts": {
    "start": "node bin/aseprite-mcp.ts serve",
    "token": "node bin/aseprite-mcp.ts token",
    "build": "node scripts/build-extension.ts",
    "test": "node --test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode/codemode": "2.0.28",
    "effect": "4.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
